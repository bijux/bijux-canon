{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bijux.org/canon/ingest/v2/source-record.schema.json",
  "title": "Immutable source record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "source_uri",
    "media_type",
    "byte_length",
    "content_sha256",
    "payload_ref",
    "acquired_at",
    "acquisition",
    "rights"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "artifact_type": {"const": "bijux.canon.ingest.source"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifact_id"},
    "source_uri": {"type": "string", "format": "uri", "minLength": 1},
    "media_type": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "byte_length": {"type": "integer", "minimum": 0},
    "content_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "payload_ref": {"$ref": "common.schema.json#/$defs/cas_uri"},
    "acquired_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "connector", "connector_version", "immutable_revision"],
      "properties": {
        "method": {"enum": ["file", "http", "object_store", "database", "connector"]},
        "connector": {"type": "string", "minLength": 1},
        "connector_version": {"type": "string", "minLength": 1},
        "immutable_revision": {"type": "string", "minLength": 1}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license_id", "redistribution_allowed"],
      "properties": {
        "license_id": {"type": "string", "minLength": 1},
        "redistribution_allowed": {"type": "boolean"}
      }
    },
    "annotations": {"$ref": "common.schema.json#/$defs/annotations"}
  },
  "x-bijux-identity": {
    "algorithm": "sha-256",
    "canonicalization": "RFC 8785",
    "excluded_json_pointers": ["/artifact_id"]
  }
}
