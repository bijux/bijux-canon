{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bijux.org/canon/ingest/v2/lineage-record.schema.json",
  "title": "Immutable artifact lineage record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "inputs",
    "outputs",
    "operation",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "artifact_type": {"const": "bijux.canon.ingest.lineage"},
    "artifact_id": {"$ref": "common.schema.json#/$defs/artifact_id"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/artifact_reference"},
      "x-bijux-ordering": "artifact_id ascending"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/artifact_reference"},
      "x-bijux-ordering": "artifact_id ascending"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "implementation", "implementation_version", "configuration_sha256", "deterministic"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "implementation": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "minLength": 1},
        "configuration_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "deterministic": {"type": "boolean"}
      }
    },
    "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "completed_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  },
  "x-bijux-identity": {
    "algorithm": "sha-256",
    "canonicalization": "RFC 8785",
    "excluded_json_pointers": ["/artifact_id"]
  }
}
