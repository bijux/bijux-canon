{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bijux.org/canon/index/v2/retrieval-artifacts.schema.json",
  "title": "Bijux Canon retrieval and vector-execution artifact records",
  "oneOf": [
    {"$ref": "#/$defs/query"},
    {"$ref": "#/$defs/candidate"},
    {"$ref": "#/$defs/fused_hit"},
    {"$ref": "#/$defs/witness"},
    {"$ref": "#/$defs/approximation"},
    {"$ref": "#/$defs/execution"},
    {"$ref": "#/$defs/provenance"},
    {"$ref": "#/$defs/replay"}
  ],
  "$defs": {
    "artifact_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "ordered_artifact_ids": {"type": "array", "items": {"$ref": "#/$defs/artifact_id"}, "uniqueItems": true, "x-bijux-ordering": "declared rank ascending, then artifact_id ascending"},
    "sorted_artifact_ids": {"type": "array", "items": {"$ref": "#/$defs/artifact_id"}, "uniqueItems": true, "x-bijux-ordering": "artifact_id ascending"},
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["name", "value"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}, "value": {"type": ["string", "integer", "number", "boolean"]}}
    },
    "channel_budget": {
      "type": "object", "additionalProperties": false, "required": ["channel", "candidate_limit", "max_latency_ms"],
      "properties": {
        "channel": {"enum": ["lexical", "dense"]}, "candidate_limit": {"type": "integer", "minimum": 1}, "max_latency_ms": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "deduplication_policy": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "lineage_key"],
      "properties": {"enabled": {"type": "boolean"}, "lineage_key": {"enum": ["content_hash", "source_span"]}}
    },
    "diversity_policy": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "strategy", "maximum_per_source", "maximum_per_section"],
      "properties": {
        "enabled": {"type": "boolean"}, "strategy": {"enum": ["none", "source-section"]}, "maximum_per_source": {"type": "integer", "minimum": 1}, "maximum_per_section": {"type": "integer", "minimum": 1}
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": false}}}, "then": {"properties": {"strategy": {"const": "none"}}}}, {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"strategy": {"const": "source-section"}}}}]
    },
    "rerank_policy": {
      "type": "object", "additionalProperties": false, "required": ["enabled", "candidate_limit", "timeout_ms", "reranker_artifact_id", "failure_policy"],
      "properties": {
        "enabled": {"type": "boolean"}, "candidate_limit": {"type": "integer", "minimum": 1}, "timeout_ms": {"type": "integer", "minimum": 1}, "reranker_artifact_id": {"oneOf": [{"$ref": "#/$defs/artifact_id"}, {"type": "null"}]}, "failure_policy": {"enum": ["retain-retrieval-order", "refuse"]}
      },
      "allOf": [{"if": {"properties": {"enabled": {"const": false}}}, "then": {"properties": {"reranker_artifact_id": {"type": "null"}}}}, {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"reranker_artifact_id": {"$ref": "#/$defs/artifact_id"}}}}]
    },
    "retrieval_scope": {
      "type": "object", "additionalProperties": false, "required": ["source_ids", "document_ids", "section_ids", "allow_unscoped"],
      "properties": {
        "source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "x-bijux-ordering": "lexicographic"},
        "document_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "x-bijux-ordering": "lexicographic"},
        "section_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "x-bijux-ordering": "lexicographic"},
        "allow_unscoped": {"type": "boolean"}
      },
      "allOf": [{"if": {"properties": {"allow_unscoped": {"const": false}}}, "then": {"anyOf": [{"properties": {"source_ids": {"minItems": 1}}}, {"properties": {"document_ids": {"minItems": 1}}}, {"properties": {"section_ids": {"minItems": 1}}}]}}]
    },
    "trace_requirements": {
      "type": "object", "additionalProperties": false, "required": ["persist", "include_candidates", "include_decisions", "include_timings"],
      "properties": {"persist": {"type": "boolean"}, "include_candidates": {"type": "boolean"}, "include_decisions": {"type": "boolean"}, "include_timings": {"type": "boolean"}}
    },
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "artifact_id", "corpus_artifact_id", "generation_artifact_id", "query_text", "query_text_sha256", "retrieval_mode", "top_k", "channels", "channel_budgets", "filter_artifact_ids", "deduplication", "diversity", "rerank", "scope", "offline_policy", "trace_requirements", "execution_contract", "random_seed", "created_at"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact_type": {"const": "bijux.canon.index.query"}, "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "corpus_artifact_id": {"$ref": "#/$defs/artifact_id"}, "generation_artifact_id": {"$ref": "#/$defs/artifact_id"}, "query_text": {"type": "string", "minLength": 1, "pattern": "\\S"}, "query_text_sha256": {"$ref": "#/$defs/sha256"},
        "retrieval_mode": {"enum": ["lexical", "dense-exact", "local-hybrid-exact", "local-hybrid-ann"]}, "top_k": {"type": "integer", "minimum": 1, "maximum": 1000}, "channels": {"type": "array", "minItems": 1, "items": {"enum": ["lexical", "dense"]}, "uniqueItems": true, "x-bijux-ordering": "lexical before dense"},
        "channel_budgets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/channel_budget"}, "uniqueItems": true, "x-bijux-ordering": "channel lexical before dense"},
        "filter_artifact_ids": {"$ref": "#/$defs/ordered_artifact_ids"}, "execution_contract": {"enum": ["deterministic", "non_deterministic"]},
        "deduplication": {"$ref": "#/$defs/deduplication_policy"}, "diversity": {"$ref": "#/$defs/diversity_policy"}, "rerank": {"$ref": "#/$defs/rerank_policy"}, "scope": {"$ref": "#/$defs/retrieval_scope"},
        "offline_policy": {"enum": ["required", "preferred", "forbidden"]}, "trace_requirements": {"$ref": "#/$defs/trace_requirements"},
        "random_seed": {"oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]}, "created_at": {"$ref": "#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"retrieval_mode": {"const": "lexical"}}},
          "then": {"properties": {"channels": {"const": ["lexical"]}, "channel_budgets": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/channel_budget"}, {"properties": {"channel": {"const": "lexical"}}}]}}}}
        },
        {
          "if": {"properties": {"retrieval_mode": {"const": "dense-exact"}}},
          "then": {"properties": {"channels": {"const": ["dense"]}, "channel_budgets": {"minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/channel_budget"}, {"properties": {"channel": {"const": "dense"}}}]}}}}
        },
        {
          "if": {"properties": {"retrieval_mode": {"enum": ["local-hybrid-exact", "local-hybrid-ann"]}}},
          "then": {
            "properties": {
              "channels": {"const": ["lexical", "dense"]},
              "channel_budgets": {
                "minItems": 2, "maxItems": 2,
                "prefixItems": [
                  {"allOf": [{"$ref": "#/$defs/channel_budget"}, {"properties": {"channel": {"const": "lexical"}}}]},
                  {"allOf": [{"$ref": "#/$defs/channel_budget"}, {"properties": {"channel": {"const": "dense"}}}]}
                ],
                "items": false
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "artifact_id", "query_artifact_id", "chunk_artifact_id", "segment_artifact_id", "channel", "rank", "score", "score_semantics", "deterministic_tiebreak"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact_type": {"const": "bijux.canon.index.candidate"}, "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "query_artifact_id": {"$ref": "#/$defs/artifact_id"}, "chunk_artifact_id": {"$ref": "#/$defs/artifact_id"}, "segment_artifact_id": {"$ref": "#/$defs/artifact_id"},
        "channel": {"enum": ["lexical", "dense"]}, "rank": {"type": "integer", "minimum": 1}, "score": {"type": "number"},
        "score_semantics": {"enum": ["higher_is_better", "lower_is_better"]}, "deterministic_tiebreak": {"const": "score_then_chunk_artifact_id"}
      }
    },
    "contribution": {
      "type": "object", "additionalProperties": false, "required": ["candidate_artifact_id", "channel", "channel_rank", "weighted_score"],
      "properties": {"candidate_artifact_id": {"$ref": "#/$defs/artifact_id"}, "channel": {"enum": ["lexical", "dense"]}, "channel_rank": {"type": "integer", "minimum": 1}, "weighted_score": {"type": "number"}}
    },
    "fused_hit": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "artifact_id", "query_artifact_id", "chunk_artifact_id", "rank", "fused_score", "fusion_method", "contributions", "deterministic_tiebreak"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact_type": {"const": "bijux.canon.index.fused_hit"}, "artifact_id": {"$ref": "#/$defs/artifact_id"},
        "query_artifact_id": {"$ref": "#/$defs/artifact_id"}, "chunk_artifact_id": {"$ref": "#/$defs/artifact_id"}, "rank": {"type": "integer", "minimum": 1},
        "fused_score": {"type": "number"}, "fusion_method": {"enum": ["rrf-v1", "weighted-sum-v1"]},
        "contributions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contribution"}, "uniqueItems": true, "x-bijux-ordering": "channel lexical before dense, then candidate_artifact_id"},
        "deterministic_tiebreak": {"const": "fused_score_then_chunk_artifact_id"}
      }
    },
    "witness": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "artifact_id", "query_artifact_id", "exact_candidate_artifact_ids", "approximate_candidate_artifact_ids", "sample_k", "overlap_ratio", "recall_at_k", "rank_displacement"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact_type": {"const": "bijux.canon.index.witness"}, "artifact_id": {"$ref": "#/$defs/artifact_id"}, "query_artifact_id": {"$ref": "#/$defs/artifact_id"},
        "exact_candidate_artifact_ids": {"allOf": [{"$ref": "#/$defs/ordered_artifact_ids"}, {"minItems": 1}]}, "approximate_candidate_artifact_ids": {"allOf": [{"$ref": "#/$defs/ordered_artifact_ids"}, {"minItems": 1}]},
        "sample_k": {"type": "integer", "minimum": 1}, "overlap_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "recall_at_k": {"type": "number", "minimum": 0, "maximum": 1}, "rank_displacement": {"type": "number", "minimum": 0}
      }
    },
    "approximation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "artifact_id", "query_artifact_id", "generation_artifact_id", "witness_artifact_id", "algorithm", "algorithm_version", "backend", "backend_version", "parameters", "random_seed", "candidate_count", "recall_at_k", "allowed_recall_drop", "allowed_rank_jitter", "degraded"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact_type": {"const": "bijux.canon.index.approximation"}, "artifact_id": {"$ref": "#/$defs/artifact_id"}, "query_artifact_id": {"$ref": "#/$defs/artifact_id"}, "generation_artifact_id": {"$ref": "#/$defs/artifact_id"}, "witness_artifact_id": {"$ref": "#/$defs/artifact_id"},
        "algorithm": {"type": "string", "minLength": 1}, "algorithm_version": {"type": "string", "minLength": 1}, "backend": {"type": "string", "minLength": 1}, "backend_version": {"type": "string", "minLength": 1},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}, "uniqueItems": true, "x-bijux-ordering": "name ascending"}, "random_seed": {"type": "integer", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 1}, "recall_at_k": {"type": "number", "minimum": 0, "maximum": 1}, "allowed_recall_drop": {"type": "number", "minimum": 0, "maximum": 1}, "allowed_rank_jitter": {"type": "integer", "minimum": 0}, "degraded": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "artifact_id", "query_artifact_id", "query_vector_sha256", "generation_artifact_id", "backend_binding", "filter_artifact_ids", "execution_budget", "software_versions", "hardware_class", "candidate_artifact_ids", "candidate_order_sha256", "fused_hit_artifact_ids", "approximation_artifact_id", "status", "result_sha256", "started_at", "completed_at"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact_type": {"const": "bijux.canon.index.execution"}, "artifact_id": {"$ref": "#/$defs/artifact_id"}, "query_artifact_id": {"$ref": "#/$defs/artifact_id"}, "query_vector_sha256": {"$ref": "#/$defs/sha256"}, "generation_artifact_id": {"$ref": "#/$defs/artifact_id"},
        "backend_binding": {
          "type": "object", "additionalProperties": false, "required": ["backend", "backend_version", "algorithm", "algorithm_version", "index_parameters", "query_parameters"],
          "properties": {
            "backend": {"type": "string", "minLength": 1}, "backend_version": {"type": "string", "minLength": 1}, "algorithm": {"type": "string", "minLength": 1}, "algorithm_version": {"type": "string", "minLength": 1},
            "index_parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}, "uniqueItems": true, "x-bijux-ordering": "name ascending"}, "query_parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}, "uniqueItems": true, "x-bijux-ordering": "name ascending"}
          }
        },
        "filter_artifact_ids": {"$ref": "#/$defs/sorted_artifact_ids"},
        "execution_budget": {
          "type": "object", "additionalProperties": false, "required": ["max_latency_ms", "max_memory_bytes", "max_candidates", "max_distance_computations", "minimum_recall"],
          "properties": {"max_latency_ms": {"type": "number", "exclusiveMinimum": 0}, "max_memory_bytes": {"type": "integer", "minimum": 1}, "max_candidates": {"type": "integer", "minimum": 1}, "max_distance_computations": {"type": "integer", "minimum": 1}, "minimum_recall": {"type": "number", "minimum": 0, "maximum": 1}}
        },
        "software_versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/implementation_lock"}, "uniqueItems": true, "x-bijux-ordering": "name ascending"},
        "hardware_class": {
          "type": "object", "additionalProperties": false, "required": ["architecture", "cpu_class", "accelerator_class"],
          "properties": {"architecture": {"type": "string", "minLength": 1}, "cpu_class": {"type": "string", "minLength": 1}, "accelerator_class": {"type": "string", "minLength": 1}}
        },
        "candidate_artifact_ids": {"allOf": [{"$ref": "#/$defs/ordered_artifact_ids"}, {"minItems": 1}]}, "fused_hit_artifact_ids": {"allOf": [{"$ref": "#/$defs/ordered_artifact_ids"}, {"minItems": 1}]},
        "candidate_order_sha256": {"$ref": "#/$defs/sha256"}, "approximation_artifact_id": {"oneOf": [{"$ref": "#/$defs/artifact_id"}, {"type": "null"}]}, "status": {"enum": ["success", "partial", "failed"]}, "result_sha256": {"$ref": "#/$defs/sha256"},
        "started_at": {"$ref": "#/$defs/timestamp"}, "completed_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "implementation_lock": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "sha256"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "artifact_id", "execution_artifact_id", "input_artifact_ids", "implementation_locks", "environment_sha256", "source_commit", "recorded_at"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact_type": {"const": "bijux.canon.index.provenance"}, "artifact_id": {"$ref": "#/$defs/artifact_id"}, "execution_artifact_id": {"$ref": "#/$defs/artifact_id"},
        "input_artifact_ids": {"allOf": [{"$ref": "#/$defs/sorted_artifact_ids"}, {"minItems": 1}]}, "implementation_locks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/implementation_lock"}, "uniqueItems": true, "x-bijux-ordering": "name ascending"},
        "environment_sha256": {"$ref": "#/$defs/sha256"}, "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "recorded_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "replay": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "artifact_type", "artifact_id", "original_execution_artifact_id", "provenance_artifact_id", "expected_result_sha256", "observed_result_sha256", "outcome", "divergence", "replayed_at"],
      "properties": {
        "schema_version": {"const": "2.0.0"}, "artifact_type": {"const": "bijux.canon.index.replay"}, "artifact_id": {"$ref": "#/$defs/artifact_id"}, "original_execution_artifact_id": {"$ref": "#/$defs/artifact_id"}, "provenance_artifact_id": {"$ref": "#/$defs/artifact_id"},
        "expected_result_sha256": {"$ref": "#/$defs/sha256"}, "observed_result_sha256": {"$ref": "#/$defs/sha256"}, "outcome": {"enum": ["exact_match", "within_bounds", "diverged", "refused"]}, "divergence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "x-bijux-ordering": "lexicographic"}, "replayed_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  },
  "x-bijux-identity": {"algorithm": "sha-256", "canonicalization": "RFC 8785", "excluded_json_pointers": ["/artifact_id"]},
  "x-bijux-invariants": [
    "query identity carries corpus and generation, retrieval mode, channel budgets, filters, deduplication, diversity, reranking, scope, offline policy, and trace requirements end to end",
    "candidate and hit arrays retain declared rank order and use artifact identity for ties",
    "execution identity binds the normalized query vector, generation, backend, parameters, filters, budgets, software, hardware class, candidate order, and output hash",
    "query text, execution results, implementation locks, and provenance are hash-bound",
    "approximate execution carries a seed, witness, explicit error bounds, and immutable index generation",
    "replay compares canonical result hashes and never overwrites the original execution"
  ]
}
